// FILE: wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketplace-react",
  "main": "src/api-worker.js",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  }
}
